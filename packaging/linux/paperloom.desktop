[Desktop Entry]
Type=Application
Name=Paperloom
GenericName=Live Wallpaper
Comment=Play MP4 loops as your desktop background
Exec=paperloom-gui %f
Icon=paperloom
Terminal=false
Categories=Utility;
StartupNotify=true
StartupWMClass=paperloom
Keywords=wallpaper;live;video;background;desktop;
MimeType=application/x-paperloom-share;
